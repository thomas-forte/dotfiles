#!/bin/zsh

# Repo-root relative so ./setup works before ZDOTDIR is linked.
source "${0:A:h}/zsh/lib/picker.zsh"

macos_installs() {
    echo "Installing core tools via Homebrew:"
    echo "  - font-fira-code-nerd-font (terminal/ligature font for starship)"
    echo "  - bat (syntax-highlighted cat)"
    echo "  - starship (prompt)"
    echo "  - tmux (terminal multiplexer)"
    brew install --cask font-fira-code-nerd-font
    brew install bat starship tmux
}

macos_optional_installs() {
    echo "Installing optional tools via Homebrew:"
    echo "  - session-manager-plugin (AWS SSM sessions)"
    echo "  - awscli, curl, fish, imagemagick, nvm, python3, wget"
    echo "  - gpg2, gnupg, pinentry-mac (commit signing)"
    brew install --cask session-manager-plugin
    brew install awscli curl fish imagemagick nvm python3 wget
    brew install gpg2 gnupg pinentry-mac
}

fedora_installs() {
    echo "Installing core tools via dnf:"
    echo "  - bat (syntax-highlighted cat)"
    echo "  - starship (prompt)"
    echo "  - tmux (terminal multiplexer)"
    sudo dnf install bat starship tmux
}

fedora_optional_installs() {
    echo "Installing optional tools via dnf:"
    # echo "  - session-manager-plugin (AWS SSM sessions)"
    echo "  - awscli, curl, fish, imagemagick, python3, wget"
    echo "  - gnupg (commit signing)"
    echo "Install optional tools via curl:"
    echo "  - nvm (node version manager)"
    # sudo dnf install -y https://s3.amazonaws.com/session-manager-downloads/plugin/latest/linux_64bit/session-manager-plugin.rpm
    sudo dnf install awscli curl fish ImageMagick python3 wget
    sudo dnf install gnupg
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.6/install.sh | bash
}

debian_installs() {
    echo "Installing core tools via apt:"
    echo "  - bat (syntax-highlighted cat)"
    echo "  - starship (prompt)"
    echo "  - tmux (terminal multiplexer)"
    sudo apt-get update
    sudo apt-get install -y bat tmux curl starship
}

debian_optional_installs() {
    echo "Installing optional tools via apt:"
    # echo "  - session-manager-plugin (AWS SSM sessions)"
    echo "  - awscli, curl, fish, imagemagick, python3, wget"
    echo "  - gnupg (commit signing)"
    echo "Install optional tools via curl:"
    echo "  - nvm (node version manager)"
    sudo apt-get install -y awscli curl fish imagemagick python3 wget gnupg
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.6/install.sh | bash 
}

setup_links() {
    echo "Creating config directories and symlinking repo files into XDG paths..."
    mkdir -p ~/.config/git ~/.local/share/sendssh
    ln -sfn "$(pwd)/zsh/.zshenv" ~/.zshenv
    ln -sfn "$(pwd)/zsh" ~/.config/zsh
    ln -sfn "$(pwd)/config/git.config" ~/.config/git/config
    ln -sfn "$(pwd)/config/bat.config" ~/.config/bat.conf
    ln -sfn "$(pwd)/config/starship.toml" ~/.config/starship.toml
    ln -sfn "$(pwd)/config/wgetrc.config" ~/.config/.wgetrc
    ln -sfn "$(pwd)/sendssh/data" ~/.local/share/sendssh/data
    echo "Symlinks created."
}

_os_id() {
    [[ -r /etc/os-release ]] || return 1
    . /etc/os-release 2>/dev/null
    print -r -- "${ID:-}"
}

_os_like() {
    [[ -r /etc/os-release ]] || return 1
    . /etc/os-release 2>/dev/null
    print -r -- "${ID_LIKE:-}"
}

echo "================================================"
echo "= This script will optionally install packages ="
echo "= and create symlinks for the dotfiles in this ="
echo "= repo.                                        ="
echo "================================================"
echo

if [[ "$(uname -s)" == "Darwin" ]]; then
    if confirm "Install core Homebrew packages (font, bat, starship, tmux)?"; then
        macos_installs
    else
        echo "Skipping core Homebrew installs."
    fi
    echo

    if confirm "Install optional Homebrew packages (AWS, gpg, nvm, etc.)?"; then
        macos_optional_installs
    else
        echo "Skipping optional Homebrew installs."
    fi
    echo
elif [[ "$(uname -s)" == "Linux" ]]; then
    linux_id="$(_os_id)"
    linux_like="$(_os_like)"
    case " ${linux_id} ${linux_like} " in
        *" fedora "*)
            if confirm "Install core Fedora packages (font, bat, starship, tmux)?"; then
                fedora_installs
            else
                echo "Skipping core Fedora installs."
            fi
            echo

            if confirm "Install optional Fedora packages (AWS, gpg, nvm, etc.)?"; then
                fedora_optional_installs
            else
                echo "Skipping optional Fedora installs."
            fi
            echo
            ;;
        *" debian "*|*" ubuntu "*)
            if confirm "Install core Debian/Ubuntu packages (font, bat, starship, tmux)?"; then
                debian_installs
            else
                echo "Skipping core Debian/Ubuntu installs."
            fi
            echo

            if confirm "Install optional Debian/Ubuntu packages (AWS, gpg, nvm, etc.)?"; then
                debian_optional_installs
            else
                echo "Skipping optional Debian/Ubuntu installs."
            fi
            echo
            ;;
        *)
            echo "Unknown Linux distro (${linux_id:-unknown}) — skipping package install steps."
            echo
            ;;
    esac
else
    echo "Unknown OS — skipping package install steps."
    echo
fi

if confirm "Create/update symlinks for zsh, git, bat, and sendssh?"; then
    setup_links
else
    echo "Skipping symlink setup."
fi
